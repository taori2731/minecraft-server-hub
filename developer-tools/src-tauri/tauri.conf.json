{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Server Hub Developer Tools",
  "version": "0.3.1",
  "identifier": "local.minecraft-server-hub.developer-tools",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev:developer-tools",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm --prefix .. run build:developer-tools",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minecraft Server Hub Developer Tools",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1421; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../src-tauri/icons/icon.png", "../../src-tauri/icons/icon.ico"],
    "resources": ["../../docs/DEVELOPER_TOOLS.md", "../../docs/THIRD_PARTY_NOTICES.md", "../../docs/licenses/MPL-2.0.txt"],
    "windows": {
      "nsis": {
        "installerIcon": "../../src-tauri/icons/icon.ico",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NzZGQTZEQTk0M0FBNjAKUldSZ3FrT3BiZnAyTmI2a05GUnMyZ3czSlFVUVFTYjNBQmFHbmdWclJpU2pqV2s1Rm0yNFVOVlgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
