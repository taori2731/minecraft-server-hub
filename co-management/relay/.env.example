NODE_ENV=production
MSH_CO_MANAGEMENT_HOST=0.0.0.0
MSH_CO_MANAGEMENT_PORT=8787
MSH_CO_MANAGEMENT_UI_DIR=../browser/dist
MSH_CO_MANAGEMENT_ALLOWED_ORIGINS=https://staging.cohostrelay.online
MSH_CO_MANAGEMENT_DATABASE_URL=postgres://APP_USER:REDACTED@DB_HOST:5432/cohostrelay
# Use a direct (non-PgBouncer) connection for migrations. The application URL above may be pooled.
MSH_CO_MANAGEMENT_MIGRATION_DATABASE_URL=postgres://MIGRATION_USER:REDACTED@DIRECT_DB_HOST:5432/cohostrelay
MSH_CO_MANAGEMENT_DATABASE_SSL=require
MSH_CO_MANAGEMENT_DATABASE_POOL_MAX=10
# First entry encrypts new values; later entries decrypt data during rotation.
# Generate 32 random bytes outside logs and encode with base64url.
MSH_CO_MANAGEMENT_RELAY_KEYS=v1:REPLACE_WITH_32_BYTE_BASE64URL_KEY
# Enable only when the origin accepts traffic exclusively from the trusted proxy.
MSH_CO_MANAGEMENT_TRUST_PROXY=0
# Start with 0. Set a short staging value after HTTPS/WSS verification.
MSH_CO_MANAGEMENT_HSTS_MAX_AGE=0
# Maximum WebSocket upgrade attempts per source in a 60-second window.
MSH_CO_MANAGEMENT_MAX_WEBSOCKET_UPGRADE_ATTEMPTS=60
# Maximum queued bytes already buffered on one connected host WebSocket.
# The relay closes the socket before sending beyond this bound.
MSH_CO_MANAGEMENT_MAX_HOST_EVENT_BUFFERED_BYTES=8388608
