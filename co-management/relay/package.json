{
  "name": "minecraft-server-hub-co-management-relay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "maintenance": "tsx src/maintenance.ts",
    "test": "tsx --test src/*.test.ts",
    "start": "tsx src/server.ts",
    "start:production": "npm run migrate && npm start"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "pg": "8.16.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "26.4.1",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
